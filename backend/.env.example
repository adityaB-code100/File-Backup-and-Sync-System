# ==============================================================================
# VaultCloud Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env`
# Replace all placeholder values with your environment configuration.
# DO NOT COMMIT LIVE PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# MongoDB Connection String (Atlas URI or local standalone instance)
MONGO_URI=mongodb://localhost:27017/cloud_storage_db

# Django Secret Key
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-for-development

# JWT Signing Key
JWT_SIGNING_KEY=replace-with-a-random-jwt-signing-key

# Master Key Encryption Key (KEK) for Envelope Encryption (AES-256-GCM)
# 32-byte (256-bit) base64 encoded key
# Generate using: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
FILE_ENCRYPTION_KEK=YOUR_BASE64_ENCODED_32_BYTE_KEK_HERE

# Development Mode (True / False)
DEBUG=True

# Network Host Access
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Encrypted Blob Storage Location
STORAGE_ROOT=./file_storage

# Maximum Upload Size Enforcement in Bytes (Default: 104857600 = 100 MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# Mail & OTP Microservice URL and Authentication
OTP_SERVICE_URL=http://localhost:5001
OTP_SERVICE_SECRET=vaultcloud-internal-otp-secret-key-32b

# Application URLs
VAULTCLOUD_WEB_URL=http://localhost:5173
VAULTCLOUD_BACKEND_URL=http://localhost:8000/api

# Secondary Encrypted Backup Root
SECONDARY_BACKUP_ROOT=D:\VaultCloudBackup
