# Mail & OTP Microservice Configuration

# Server Settings
HOST=127.0.0.1
PORT=8001
DEBUG=True

# Shared secret between Django backend and mail_otp_server
OTP_SERVICE_SECRET=vaultcloud-internal-otp-secret-key-32b

# OTP Security Rules
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP Configuration
# For Gmail, use port 587 with STARTTLS (or port 465 with SSL)
# Google App Password is a 16-character code generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=15
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="VaultCloud Security"

# Twilio Verify / SMS Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_FROM_PHONE=+1234567890

